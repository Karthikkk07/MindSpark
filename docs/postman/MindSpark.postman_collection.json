    {
      "name": "Goals",
      "item": [
        {
          "name": "Create goal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set(\"goalId\", json.data.id); }",
                  "pm.test(\"status is 2xx\", () => pm.response.to.be.success);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Read daily\",\n  \"category\": \"growth\",\n  \"dailyAction\": \"Read for 20 minutes\",\n  \"milestones\": [\n    {\n      \"title\": \"Finish chapter 1\"\n    },\n    {\n      \"title\": \"Finish chapter 2\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/goals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goals"
              ]
            }
          }
        },
        {
          "name": "List goals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/goals?status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goals"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "Get goal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/goals/{{goalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goals",
                "{{goalId}}"
              ]
            }
          }
        },
        {
          "name": "Update goal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Twenty minutes before bed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/goals/{{goalId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goals",
                "{{goalId}}"
              ]
            }
          }
        },
        {
          "name": "Check in for a day",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-11-14\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/goals/{{goalId}}/check-ins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "goals",
                "{{goalId}}",
                "check-ins"
              ]
            }
          }
        },
        {
          "name": "Undo a check-in",
          "request": {
            "method": "DELETE",
